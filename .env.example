# Development credentials only. Keep these values consistent with DATABASE_URL.
POSTGRES_USER=gameops
POSTGRES_PASSWORD=gameops_local_only
POSTGRES_DB=gameops
POSTGRES_PORT=54329
DATABASE_URL=postgresql://gameops:gameops_local_only@127.0.0.1:54329/gameops
API_PORT=4000
API_ORIGIN=http://127.0.0.1:4000
APP_ORIGIN=http://127.0.0.1:3000
# npm run setup generates this value in .env without printing it.
CSRF_SECRET=replace-with-a-random-secret-using-npm-run-setup
# Integration tests require a separate, disposable database.
TEST_DATABASE_URL=postgresql://gameops:gameops_local_only@127.0.0.1:54329/gameops_test
